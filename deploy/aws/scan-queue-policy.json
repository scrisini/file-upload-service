{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EventBridgeSendsScanEvents",
      "Effect": "Allow",
      "Principal": {"Service": "events.amazonaws.com"},
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:ap-southeast-2:123456789012:file-upload-scan-events",
      "Condition": {
        "ArnEquals": {
          "aws:SourceArn": [
            "arn:aws:events:ap-southeast-2:123456789012:rule/file-upload-object-created",
            "arn:aws:events:ap-southeast-2:123456789012:rule/file-upload-scan-result"
          ]
        }
      }
    }
  ]
}
