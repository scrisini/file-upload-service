{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadAndPromote",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject", "s3:GetObjectTagging"],
      "Resource": "arn:aws:s3:::file-upload-quarantine/uploads/*"
    },
    {
      "Sid": "WriteAndServeClean",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::file-upload-clean/files/*"
    },
    {
      "Sid": "HealthAndPromotionChecks",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::file-upload-quarantine", "arn:aws:s3:::file-upload-clean"]
    },
    {
      "Sid": "FileRecords",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem",
                 "dynamodb:Query", "dynamodb:DescribeTable"],
      "Resource": ["arn:aws:dynamodb:ap-southeast-2:123456789012:table/file-upload-service-files",
                   "arn:aws:dynamodb:ap-southeast-2:123456789012:table/file-upload-service-files/index/scanning"]
    },
    {
      "Sid": "ScanEvents",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:ap-southeast-2:123456789012:file-upload-scan-events"
    }
  ]
}
