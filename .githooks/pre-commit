#!/usr/bin/env bash
#
# pre-commit hook: rejects plaintext secrets in the staged files (scripts/check-secrets.sh).
# Installed with the other hooks by `scripts/dev.sh hooks`.

set -euo pipefail

# next to this hook's directory, so it also works where .githooks isn't at the repository root
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/check-secrets.sh"
